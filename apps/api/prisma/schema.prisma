generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  front_desk
  teacher
  student
  parent
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum LevelChangeSource {
  placement
  evaluation
  admin
}

enum EnrollmentStatus {
  pending_payment
  active
  completed
  dropped
}

enum PaymentStatus {
  draft
  open
  paid
  void
  overdue
}

enum CourseType {
  group
  private
}

enum LessonSessionStatus {
  scheduled
  completed
  cancelled
  rescheduled
}

enum AttendanceStatus {
  present
  absent
  excused
}

model User {
  id                      String                @id @default(uuid()) @db.Uuid
  name                    String
  email                   String                @unique
  passwordHash            String?               @map("password_hash")
  role                    Role
  phone                   String?
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  refreshTokens           RefreshToken[]
  student                 Student?
  teacher                 Teacher?
  confirmedPlacementTests PlacementTest[]       @relation("PlacementTestConfirmedBy")
  studentLevelChanges     StudentLevelHistory[]
  attendanceMarked        Attendance[]

  @@map("users")
}

model Student {
  id                     String                @id @default(uuid()) @db.Uuid
  userId                 String                @unique @map("user_id") @db.Uuid
  cefrLevel              CefrLevel?            @map("cefr_level")
  targetLevel            CefrLevel?            @map("target_level")
  lessonCreditsRemaining Decimal               @default(0) @map("lesson_credits_remaining") @db.Decimal(6, 2)
  createdAt              DateTime              @default(now()) @map("created_at")
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  placementTests         PlacementTest[]
  levelHistory           StudentLevelHistory[]
  enrollments            Enrollment[]
  invoices               Invoice[]
  attendance             Attendance[]

  @@map("students")
}

model Teacher {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  specializations   String[]
  hourlyRate        Decimal  @default(0) @map("hourly_rate") @db.Decimal(8, 2)
  isNative          Boolean  @default(false) @map("is_native")
  zoomPersonalLink  String?  @map("zoom_personal_link")
  createdAt         DateTime @default(now()) @map("created_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  batches           Batch[]
  sessions          LessonSession[]

  @@map("teachers")
}

model Course {
  id             String     @id @default(uuid()) @db.Uuid
  name           String
  courseType     CourseType @map("course_type")
  cefrLevel      CefrLevel  @map("cefr_level")
  specialization String     @default("General")
  defaultCapacity Int       @map("default_capacity")
  tuitionAmount  Decimal    @map("tuition_amount") @db.Decimal(10, 2)
  currency       String     @default("USD")
  createdAt      DateTime   @default(now()) @map("created_at")
  batches        Batch[]

  @@map("courses")
}

model Batch {
  id            String          @id @default(uuid()) @db.Uuid
  courseId      String          @map("course_id") @db.Uuid
  teacherId     String          @map("teacher_id") @db.Uuid
  scheduleLabel String          @map("schedule_label")
  weekdays      Int[]
  startTime     String          @map("start_time")
  endTime       String          @map("end_time")
  roomNumber    String?         @map("room_number")
  meetingUrl    String?         @map("meeting_url")
  startDate     DateTime        @map("start_date") @db.Date
  endDate       DateTime        @map("end_date") @db.Date
  capacity      Int
  createdAt     DateTime        @default(now()) @map("created_at")
  course        Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher       Teacher         @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  enrollments   Enrollment[]
  sessions      LessonSession[]

  @@index([courseId])
  @@map("batches")
}

model SchoolHoliday {
  id          String   @id @default(uuid()) @db.Uuid
  observedOn  DateTime @unique @map("observed_on") @db.Date
  name        String
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("school_holidays")
}

model LessonSession {
  id          String              @id @default(uuid()) @db.Uuid
  batchId     String?             @map("batch_id") @db.Uuid
  teacherId   String              @map("teacher_id") @db.Uuid
  startsAt    DateTime            @map("starts_at")
  endsAt      DateTime            @map("ends_at")
  roomNumber  String?             @map("room_number")
  meetingUrl  String?             @map("meeting_url")
  status      LessonSessionStatus
  createdAt   DateTime            @default(now()) @map("created_at")
  batch       Batch?              @relation(fields: [batchId], references: [id], onDelete: Cascade)
  teacher     Teacher             @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  attendance  Attendance[]

  @@unique([batchId, startsAt])
  @@index([teacherId, startsAt])
  @@index([startsAt])
  @@map("lesson_sessions")
}

model Attendance {
  id             String           @id @default(uuid()) @db.Uuid
  sessionId      String           @map("session_id") @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  status         AttendanceStatus
  markedAt       DateTime         @default(now()) @map("marked_at")
  markedByUserId String?          @map("marked_by_user_id") @db.Uuid
  session        LessonSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  markedBy       User?            @relation(fields: [markedByUserId], references: [id])

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@map("attendance")
}

model Enrollment {
  id                  String           @id @default(uuid()) @db.Uuid
  studentId           String           @map("student_id") @db.Uuid
  batchId             String           @map("batch_id") @db.Uuid
  status              EnrollmentStatus
  levelOverrideReason String?          @map("level_override_reason")
  createdAt           DateTime         @default(now()) @map("created_at")
  student             Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch               Batch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  invoice             Invoice?

  @@index([studentId])
  @@index([batchId])
  @@map("enrollments")
}

model Invoice {
  id                 String        @id @default(uuid()) @db.Uuid
  studentId          String        @map("student_id") @db.Uuid
  enrollmentId       String?       @unique @map("enrollment_id") @db.Uuid
  amount             Decimal       @db.Decimal(10, 2)
  currency           String
  creditHoursBought  Decimal       @default(0) @map("credit_hours_bought") @db.Decimal(6, 2)
  paymentStatus      PaymentStatus @map("payment_status")
  dueDate            DateTime      @map("due_date") @db.Date
  description        String
  createdAt          DateTime      @default(now()) @map("created_at")
  student            Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment         Enrollment?   @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@map("invoices")
}

model PlacementScoreBand {
  id        String    @id @default(uuid()) @db.Uuid
  minScore  Decimal   @map("min_score") @db.Decimal(5, 2)
  maxScore  Decimal   @map("max_score") @db.Decimal(5, 2)
  cefrLevel CefrLevel @map("cefr_level")

  @@map("placement_score_bands")
}

model PlacementTest {
  id               String    @id @default(uuid()) @db.Uuid
  studentId        String    @map("student_id") @db.Uuid
  takenAt          DateTime  @map("taken_at")
  listening        Decimal?  @db.Decimal(5, 2)
  reading          Decimal?  @db.Decimal(5, 2)
  writing          Decimal?  @db.Decimal(5, 2)
  speaking         Decimal?  @db.Decimal(5, 2)
  overall          Decimal   @db.Decimal(5, 2)
  recommendedLevel CefrLevel @map("recommended_level")
  confirmedAt      DateTime? @map("confirmed_at")
  confirmedByUserId String?  @map("confirmed_by_user_id") @db.Uuid
  notes            String?
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  confirmedBy      User?     @relation("PlacementTestConfirmedBy", fields: [confirmedByUserId], references: [id])

  @@index([studentId])
  @@map("placement_tests")
}

model StudentLevelHistory {
  id          String            @id @default(uuid()) @db.Uuid
  studentId   String            @map("student_id") @db.Uuid
  fromLevel   CefrLevel?        @map("from_level")
  toLevel     CefrLevel         @map("to_level")
  source      LevelChangeSource
  actorUserId String            @map("actor_user_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at")
  student     Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  actor       User              @relation(fields: [actorUserId], references: [id])

  @@index([studentId, createdAt])
  @@map("student_level_history")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
